# MongoDB Atlas connection string — MUST point at a database that is
# entirely separate from baby-loader's. This app defaults to the "waitingpages"
# database (see src/lib/mongodb.ts); use a different cluster/project too if you
# want full isolation, not just a different database name.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Root domain that tenant subdomains are served under, e.g. a tenant with
# slug "emma" is reachable at emma.example.com. No protocol, no port.
ROOT_DOMAIN="example.com"

# VAPID keys for web push — generate with: npm run generate-vapid
# Shared across all tenants (see plan: one keypair, subscriptions scoped by tenantId).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"

# Secret used to sign account session cookies and hash passwords.
# Generate a long random string; changing it invalidates all sessions.
SESSION_SECRET=""
