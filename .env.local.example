# Root domain that Sites are served under, e.g. a Site with slug "emma" is
# reachable at emma.example.com. No protocol; a port only for localhost.
# A Preview's is its own workers.dev host, where Sites are served at
# /sites/<slug>.
ROOT_DOMAIN="localhost:3000"

# Which deployment this is: production, staging or preview, set by each
# Worker's wrangler config. Leave it unset locally, which is development.
# GIT_COMMIT_SHA and GIT_BRANCH, set by the deploy, are unset locally too.
# APP_ENV=""

# VAPID keys for web push — generate with: npm run generate-vapid
# Shared across all tenants (see plan: one keypair, subscriptions scoped by tenantId).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"

# Secret used to sign account session cookies. Password hashes don't use it:
# each one carries its own random salt (see src/lib/auth.ts).
# Generate with `openssl rand -base64 48`; changing it logs everyone out.
SESSION_SECRET=""

# S3-compatible media storage. Cloudflare R2 uses the account endpoint and
# API token credentials; the public URL is the R2 bucket's Cloudflare custom
# domain, such as https://media.loading.baby. All values are required to start.
MEDIA_STORAGE_ENDPOINT=""
MEDIA_STORAGE_BUCKET=""
MEDIA_STORAGE_ACCESS_KEY_ID=""
MEDIA_STORAGE_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_URL=""
# Zone-scoped Cloudflare API token with Cache Purge permission, and the
# Cloudflare zone ID for MEDIA_PUBLIC_URL.
MEDIA_CACHE_PURGE_TOKEN=""
MEDIA_CACHE_PURGE_ZONE_ID=""
