# MongoDB for local development: the one `npm run db:up` starts in Docker.
# Never put the production cluster here: production's credentials live only
# in the Production scope of the production Vercel project. To run the local
# app against staging's database, use `npm run dev:staging`
# (see .env.staging.local.example).
MONGODB_URI="mongodb://localhost:27017"

# Database name. Unset, it is "waitingpages-staging", or "waitingpages-<branch>"
# on a Vercel preview deployment, and a production deployment refuses to start
# without it (see src/lib/dbName.ts). Indexes are created on first connection.
MONGODB_DB_NAME="waitingpages-dev"

# Root domain that Sites are served under, e.g. a Site with slug "emma" is
# reachable at emma.example.com. No protocol; a port only for localhost.
# Unset on Vercel preview deployments, which fall back to their branch URL
# and serve Sites at /sites/<slug>.
ROOT_DOMAIN="localhost:3000"

# VAPID keys for web push — generate with: npm run generate-vapid
# Shared across all tenants (see plan: one keypair, subscriptions scoped by tenantId).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"

# Secret used to sign account session cookies. Password hashes don't use it:
# each one carries its own random salt (see src/lib/auth.ts).
# Generate with `openssl rand -base64 48`; changing it logs everyone out.
SESSION_SECRET=""
