{
  "name": "baby-loader-as-a-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "generate-vapid": "node scripts/generate-vapid.js",
    "brand": "node scripts/brand-kit.mjs",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 --experimental-strip-types src/lib/*.test.ts",
    "test:storybook": "vitest run --project=storybook",
    "e2e": "playwright test",
    "e2e:staging": "node --env-file=.env.staging.local node_modules/.bin/playwright test",
    "e2e:report": "playwright show-report",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply waitingpages-staging --local",
    "db:up": "docker compose up -d --wait",
    "seed": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-data.mjs demo",
    "format": "biome check --write",
    "prepare": "test ! -e .git || lefthook install"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "frimousse": "^0.4.0",
    "maplibre-gl": "^6.14.0",
    "mongodb": "^6.5.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ua-parser-js": "^1.0.38",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "@types/web-push": "^3.6.3",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "drizzle-kit": "^0.31.11",
    "lefthook": "2.2.2",
    "mongodb-memory-server": "^10.4.3",
    "opentype.js": "1.3.4",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.3",
    "typescript": "^5.0.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "^4.153.0"
  }
}
