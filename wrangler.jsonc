// The loading-baby-staging Worker: staging at the top level, and one Preview
// per branch in `previews` (ADR-0009). Production lives in
// wrangler.production.jsonc. Secrets are set in the account, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loading-baby-staging",
  "account_id": "7163354ec1980b37f6d1622ced676359",
  // Variables set in the dashboard, such as NEXT_PUBLIC_VAPID_PUBLIC_KEY,
  // survive a deploy only with this: wrangler replaces them by default.
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "loading-baby-staging" }],
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "staging", "ROOT_DOMAIN": "staging-loading-baby.fyi" },
  "r2_buckets": [{ "binding": "WEBSITE_ASSETS", "bucket_name": "loading-baby-staging-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loading-baby-staging",
      "database_id": "74bd2d41-2f4d-457f-8c59-a2e4209683e9",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "staging-loading-baby.fyi/*", "zone_name": "staging-loading-baby.fyi" },
    { "pattern": "*.staging-loading-baby.fyi/*", "zone_name": "staging-loading-baby.fyi" }
  ],
  // Routes would switch workers.dev off by default; Previews need it on.
  "workers_dev": true,
  "preview_urls": true,
  "previews": {
    "vars": { "APP_ENV": "preview" },
    "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "loading-baby-staging" }],
    // The deploy workflow points each Preview at its branch's own database.
    "r2_buckets": [{ "binding": "WEBSITE_ASSETS", "bucket_name": "loading-baby-staging-media" }],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "loading-baby-staging",
        "database_id": "74bd2d41-2f4d-457f-8c59-a2e4209683e9",
        "migrations_dir": "migrations"
      }
    ]
  }
}
