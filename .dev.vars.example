# Variables for `npm run cf:preview`, which runs the Worker build locally.
# Copy to .dev.vars (gitignored); the values match .env.local.example's.
NEXTJS_ENV="production"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"
SESSION_SECRET=""
# Media lives in the Worker's R2 bucket, reached through its binding; under
# `npm run dev` that is a local bucket, served from the page's own origin.
# MEDIA_PUBLIC_URL is the bucket's Cloudflare custom domain, such as
# https://media.loading.baby, which every stored file's URL starts with.
MEDIA_PUBLIC_URL=""
# Zone-scoped Cloudflare API token with Cache Purge permission, and the
# Cloudflare zone ID for MEDIA_PUBLIC_URL. Required on a deployment, where
# the media domain caches every file; development may leave them empty.
MEDIA_CACHE_PURGE_TOKEN=""
MEDIA_CACHE_PURGE_ZONE_ID=""
# Sites at <slug>.localhost:8787; the config's staging domain would not reach this machine.
ROOT_DOMAIN="localhost:8787"
# wrangler.jsonc says staging; a local run is development.
APP_ENV="development"
