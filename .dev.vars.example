# Variables for `npm run cf:preview`, which runs the Worker build locally.
# Copy to .dev.vars (gitignored); the values match .env.local.example's.
NEXTJS_ENV="production"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"
SESSION_SECRET=""
# S3-compatible media storage. Cloudflare R2 uses the account endpoint and
# API token credentials; MEDIA_PUBLIC_URL is the R2 bucket's custom domain.
# All values are required to start the local Worker.
MEDIA_STORAGE_ENDPOINT=""
MEDIA_STORAGE_BUCKET=""
MEDIA_STORAGE_ACCESS_KEY_ID=""
MEDIA_STORAGE_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_URL=""
# Zone-scoped Cloudflare API token with Cache Purge permission, and the
# Cloudflare zone ID for MEDIA_PUBLIC_URL.
MEDIA_CACHE_PURGE_TOKEN=""
MEDIA_CACHE_PURGE_ZONE_ID=""
# Sites at <slug>.localhost:8787; the config's staging domain would not reach this machine.
ROOT_DOMAIN="localhost:8787"
# wrangler.jsonc says staging; a local run is development.
APP_ENV="development"
