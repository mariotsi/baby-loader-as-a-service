# Copy to .env.staging.local (ignored by git) to work against staging from
# this machine. Read only by `npm run dev:staging` and `npm run e2e:staging`;
# values here win over .env.local.

# Non-production cluster, staging's database. The same cluster holds every
# preview deployment's database (ADR-0005).
MONGODB_URI="mongodb+srv://user:password@non-production-cluster.mongodb.net/"
MONGODB_DB_NAME="waitingpages-staging"

# `npm run e2e:staging`: the suite runs against the deployed staging and
# writes its test data to the same database.
E2E_BASE_URL="https://staging.loading.baby"
E2E_MONGODB_URI="mongodb+srv://user:password@non-production-cluster.mongodb.net/"
# Password of the fixture Owners, the E2E_PASSWORD repository secret.
E2E_PASSWORD=""
