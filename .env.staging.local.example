# Copy to .env.staging.local (ignored by git) to run the E2E suite against
# staging from this machine with `npm run e2e:staging`.

# The deployed staging, whose D1 database (loading-baby-staging) the suite
# writes its test data to.
E2E_BASE_URL="https://staging-loading-baby.fyi"
# Password of the fixture Owners, the E2E_PASSWORD repository secret.
E2E_PASSWORD=""

# Let `wrangler d1 execute` reach staging's database: an API token with D1
# edit on the account, and the account's id.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
